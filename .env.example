# =============================================================================
# FinSight Environment Configuration
# =============================================================================

# --- Environment & Server ---
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=change-this-to-a-super-secret-32-byte-hex-key-in-production
# 32-byte urlsafe base64 key for AES-256 field encryption
# You can generate one using: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=v1n78_qZ8X0A8dI3k2aBcDeFgHiJkLmNoPqRsTuVwXy=

# --- PostgreSQL with pgvector ---
# Why asyncpg? We use async/await in FastAPI so requests don't block the event loop.
POSTGRES_USER=finsight_user
POSTGRES_PASSWORD=finsight_secret
POSTGRES_DB=finsight_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
DATABASE_URL=postgresql+asyncpg://finsight_user:finsight_secret@localhost:5433/finsight_db

# --- Redis (Cache & Queue) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# --- LLM API (Google Gemini) ---
# Get your free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# --- Market Data APIs ---
# Finnhub free tier: https://finnhub.io/ (60 calls/min)
FINNHUB_API_KEY=your_finnhub_api_key_here

# --- Authentication (Google OAuth & JWT) ---
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
# Comma-separated allowlist of admin Google emails (no spaces)
ADMIN_EMAILS=you@example.com,admin@example.com

# --- Frontend URL (for CORS security) ---
FRONTEND_URL=http://localhost:3000
